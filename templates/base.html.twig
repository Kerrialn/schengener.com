<!DOCTYPE html>
<html lang="{{ app.request.getLocale() }}">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RC2MRY6R6Y"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-RC2MRY6R6Y');
    </script>
    <meta name="title" content="Schengener">
    <meta name="description" content="Schengener provides an easy to use Schengen visa short-stay visa calculator. Never over stay your visa again, simply add in your dates and calculate.">
    <meta name="keywords" content="Schengen visa short-stay visa calculator, Schengen visa calculator ">
    <meta name="robots" content="index, follow">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Schengener{% endblock %}</title>
    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>
<nav class="navbar bg-light mb-3">
    <div class="container">
        <span class="navbar-brand mb-0 h1">Shengeaner</span>
        <turbo-frame id="locale-frame" src="{{ path('locale_switch') }}" target="_top">
            <div class="spinner-border spinner-border-sm" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </turbo-frame>
    </div>
</nav>

<div class="container">
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger border-0">
            {{ message }}
        </div>
    {% endfor %}
</div>

{% block body %}{% endblock %}
</body>
</html>
