{% import 'macro/component.macro.twig' as component %}
{% extends 'base.html.twig' %}

{% block body %}
    <div class="container" data-turbo="false">
        <div class="row">

            <div class="col-12 col-md-4">
                <div class="card mb-3">
                    <img class="card-img-top" src="{{ asset('/image/eu.jpg') }}"/>
                    <div class="card-body">
                        <p>{{ 'site-information-and-purpose'|trans }}</p>
                    </div>
                    <div class="card-footer">
                        <p class="text-muted small">{{ 'disclaimer'|trans }}</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                {{ form_start(form) }}
                <div class="card shadow">
                    <div class="card-header h5">{{ 'shengen-visa-stay-calculator'|trans }}</div>
                    <div class="card-body">
                        {{ form_row(form.nationality) }}
                        <div class="row mt-3">
                            <div class="col-6">
                                {{ form_row(form.entry) }}
                            </div>
                            <div class="col-6">
                                {{ form_row(form.exit) }}
                            </div>
                        </div>
                    </div>
                    {% if stay and not country.isInShengenArea %}
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between">
                                <div class="d-flex">
                                    <div>{{ 'stay-duration'|trans }}</div>
                                    <a class="ms-1 link-dark" role="button" target="_blank" href="https://home-affairs.ec.europa.eu/policies/schengen-borders-and-visa/visa-policy_en">
                                        <i class="bi bi-info-circle-fill"></i>
                                    </a>
                                </div>
                                <div class="d-flex">
                                    <div class="{% if stay.isDurationOverNinetyDays %} text-danger {% endif %}">
                                        {{ stay.durationInDays }}
                                    </div>
                                </div>
                            </li>
                            {% if stay.daysRemainingFromNinetyDays > 0 %}
                                <li class="list-group-item d-flex justify-content-between">
                                    <div class="d-flex">
                                        <div>{{ 'days-remaining'|trans }}</div>
                                    </div>
                                    <div>
                                        {{ stay.daysRemainingFromNinetyDays }}
                                    </div>
                                </li>
                            {% endif %}
                            {% if stay.isDurationOverNinetyDays %}
                                <li class="list-group-item d-flex justify-content-between">
                                    <div class="d-flex">
                                        <div>{{ 'duration-over-ninety-days'|trans }}</div>
                                        <a class="ms-1 link-dark" role="button" href="https://home-affairs.ec.europa.eu/policies/schengen-borders-and-visa/visa-policy_en">
                                            <i class="bi bi-info-circle-fill"></i>
                                        </a>
                                    </div>
                                    <div>{{ stay.overStayInDays }}</div>
                                </li>
                            {% endif %}
                            <li class="list-group-item d-flex justify-content-between">
                                <div>{{ 'stay-allowed-until'|trans }}</div>
                                <div>{{ stay.ninetyDaysAfterEntry|format_date }}</div>
                            </li>
                            {% if country.hasVisaWaiverAgreement %}
                                <li class="list-group-item d-flex justify-content-between">
                                    <div>{{ 'next-nintey-day-entry-permited'|trans }}</div>
                                    <div>{{ stay.getNextNinteyDayEntry|format_date }}</div>
                                </li>
                            {% endif %}
                        </ul>
                    {% endif %}
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary w-100 mt-3">{{ 'submit'|trans }}</button>
                </div>
                {{ form_end(form) }}
            </div>

            <div class="col-12 col-md-4">
                {% if country %}
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between">
                            <div>
                                <div class="h3 m-0">{{ country.title|trans }}</div>
                                <div class="text-muted">{{ 'traveler-nationality'|trans }}</div>
                            </div>
                            <div>
                                <img class="img-fluid" height="50" width="50"
                                     src="{{ asset('/icons/flags/'~ country.image) }}"/>
                            </div>
                        </div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="w-75">{{ 'allowed-stay-for-90-days-in-180'|trans }}</div>
                                <div class="h5 m-0">
                                    {{ country.hasVisaWaiverAgreement ?  '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>' }}
                                </div>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="w-75">{{ 'part-of-shengen-area'|trans }}</div>
                                <div class="h5 m-0">
                                    {{ country.isInShengenArea ?  '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-x-circle-fill text-danger"></i>' }}
                                </div>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>


{% endblock %}